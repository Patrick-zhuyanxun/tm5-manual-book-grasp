<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gripper macro to attach gripper to robot flange -->
  <xacro:macro name="gripper" params="parent prefix mount_yaw:=1.5708">
    
    <!-- Fixed joint to attach flange to robot flange -->
    <joint name="${prefix}gripper_joint" type="fixed">
      <origin xyz="0 0 -0.0055" rpy="0 0 ${mount_yaw}"/>
      <parent link="${parent}"/>
      <child link="${prefix}gripper_flange"/>
    </joint>

    <!-- Link grippers_flan (gripper_flange) -->
    <link name="${prefix}gripper_flange">
      <inertial>
        <origin xyz="-0.00239415 0.00362117 0.0603812" rpy="0 0 0"/>
        <mass value="0.228939"/>
        <inertia ixx="0.00074264" ixy="-1.17807e-06" ixz="-1.52715e-06" iyy="0.000654853" iyz="-4.14412e-05" izz="0.000193301"/>
      </inertial>
