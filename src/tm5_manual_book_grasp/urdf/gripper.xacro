    <!-- Frame cam_mount (dummy link + fixed joint) -->
    <link name="${prefix}cam_mount">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-9"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}cam_mount_frame" type="fixed">
      <origin xyz="0.072 2.88615e-19 0.0154511" rpy="1.5708 -6.69813e-17 1.5708"/>
      <parent link="${prefix}gripper_flange"/>
      <child link="${prefix}cam_mount"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!-- Frame gripper_tip (dummy link + fixed joint) -->
    <link name="${prefix}gripper_tip">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-9"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}gripper_tip_frame" type="fixed">
      <origin xyz="-0.0013 0.00069 0.256" rpy="-5.55112e-17 7.37069e-16 -1.5708"/>
      <parent link="${prefix}gripper_flange"/>
      <child link="${prefix}gripper_tip"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!--
      Explicit physical reference for the fixed right finger.  The CAD places
      the electrostatic fixed-finger inner face at gripper_flange y=0.00069 m
      and its insertion tip at z=0.256 m.  Keep this frame separate from the
      MoveIt EEF name so perception never assumes that an arbitrary gripper
      midpoint is the fixed-jaw reference.
    -->
    <link name="${prefix}fixed_right_jaw_tip">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-9"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}fixed_right_jaw_tip_frame" type="fixed">
      <origin xyz="-0.0013 0.00069 0.256" rpy="-5.55112e-17 7.37069e-16 -1.5708"/>
      <parent link="${prefix}gripper_flange"/>
      <child link="${prefix}fixed_right_jaw_tip"/>
    </joint>

